<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sshclientjr"
    android:versionCode="36"
    android:versionName="36" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SshClientJr" >
        <activity
            android:name="com.sshclientjr.TerminalActivity"
            android:exported="false"
            android:theme="@style/Theme.SshClientJr.Terminal"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="com.sshclientjr.FileEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name="com.sshclientjr.FilerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <provider
            android:name="com.sshclientjr.LocalFileContentProvider"
            android:authorities="com.sshclientjr.localfile"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name="com.sshclientjr.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>