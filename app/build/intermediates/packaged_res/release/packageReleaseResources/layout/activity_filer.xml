<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/terminal_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/filerStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_connecting"
            android:textColor="@color/terminal_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/refreshButton"
            style="@style/TerminalKeyButton"
            android:background="@drawable/button_secondary"
            android:text="@string/action_refresh"
            android:textColor="@color/button_text_light" />

        <Button
            android:id="@+id/closeButton"
            style="@style/TerminalKeyButton"
            android:layout_marginStart="8dp"
            android:background="@drawable/button_secondary"
            android:text="@string/action_back"
            android:textColor="@color/button_text_light" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/panel_surface"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/local_panel_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/localPathValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <ListView
                android:id="@+id/localList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@color/surface_stroke"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/panel_surface"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_panel_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/remotePathValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/remoteCommandInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_surface"
                    android:hint="@string/hint_remote_command"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:minHeight="36dp"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/runCommandButton"
                    style="@style/TerminalKeyButton"
                    android:background="@drawable/button_secondary"
                    android:text="@string/action_run"
                    android:textColor="@color/button_text_light" />
            </LinearLayout>

            <ListView
                android:id="@+id/remoteList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:cacheColorHint="@android:color/transparent"
                android:divider="@color/surface_stroke"
                android:dividerHeight="1dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
