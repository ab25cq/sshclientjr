<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SshClientJr" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/terminal_bg</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <style name="Theme.SshClientJr.Terminal" parent="@style/Theme.SshClientJr">
        <item name="android:navigationBarColor">@color/terminal_bg</item>
        <item name="android:statusBarColor">@color/terminal_bg</item>
    </style>

    <style name="TerminalKeyButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
